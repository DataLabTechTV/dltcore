{
  "default": [
    {
      "type": "insecureAcceptAnything"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/datalabtechtv/dltcore": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/containers/datalabtechtv.pub",
          "signedIdentity": {
            "type": "exactRepository",
            "dockerRepository": "ghcr.io/datalabtechtv/dltcore"
          }
        }
      ]
    }
  }
}

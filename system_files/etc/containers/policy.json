{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "containers-storage": {
      "": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    },
    "oci": {
      "": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    },
    "docker": {
      "ghcr.io/datalabtechtv/dltcore": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/cosign.pub"
        }
      ]
    }
  }
}

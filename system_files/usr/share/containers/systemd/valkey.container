[Unit]
Description=Valkey
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=valkey
Image=docker.io/valkey/valkey:9-trixie
Network=host
Volume=valkey-data:/data
Exec=valkey-server --bind 127.0.0.1 --save 300 100 --appendonly no --maxmemory 512mb --maxmemory-policy noeviction

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
